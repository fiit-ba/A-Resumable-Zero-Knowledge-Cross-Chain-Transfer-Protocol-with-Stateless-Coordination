{
  "name": "local-agent",
  "version": "0.1.0",
  "description": "Headless local agent for the Trustless Cross-Chain relay protocol",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "trustless-agent": "./dist/main.js"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "npm run build --prefix ../stateless-client && tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "agent-shared": "*",
    "express": "^4.19.2",
    "better-sqlite3": "^11.0.0",
    "stateless-client": "file:../stateless-client"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
