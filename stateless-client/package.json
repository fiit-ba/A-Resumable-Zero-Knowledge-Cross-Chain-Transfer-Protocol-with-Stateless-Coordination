{
  "name": "stateless-client",
  "version": "0.1.0",
  "description": "TypeScript stateless client, CLI, and embedded local agent for trustless connector relay flows",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "stateless-client": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "dev:agent": "tsx src/cli.ts agent start",
    "start:agent": "node dist/cli.js agent start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "test:integration": "RUN_LOCAL_INTEGRATION=1 vitest run test/integration",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@corpus-core/colibri-stateless": "^1.1.20",
    "better-sqlite3": "^11.0.0",
    "ethers": "^6.16.0",
    "express": "^4.19.2"
  },
  "optionalDependencies": {
    "@corpus-core/colibri-stateless-dev": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/node": "^25.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "typescript-eslint": "^8.57.0",
    "globals": "^17.4.0"
  }
}
