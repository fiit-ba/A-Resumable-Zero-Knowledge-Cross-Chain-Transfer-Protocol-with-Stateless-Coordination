RPC_URL=http://127.0.0.1:8545

# Anvil default account #0 — pre-funded with 10 000 ETH on every fresh anvil instance.
# Deployer address: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Custom key (not pre-funded on a fresh anvil — run `make fund-deployer` first if you use this).
PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Two-network deployment (example: Sepolia -> Chiado)
# Use with: make deploy-connectors-prod
# ---------------------------------------------------------------------------
SOURCE_NETWORK=sepolia
DEST_NETWORK=chiado

RPC_URL_SOURCE=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_DEST=https://rpc.chiadochain.net

ACK_WINDOW_SECONDS=3600
ACK_WINDOW_SECONDS_SOURCE=3600
ACK_WINDOW_SECONDS_DEST=3600

# ---------------------------------------------------------------------------
# Bootstrap (Stage 2) — fill in after running `make deploy-all` + `make addresses`
# ---------------------------------------------------------------------------
SOURCE_CHAIN_ID=31337
DEST_CHAIN_ID=31338

# Addresses from the deploy-all broadcast logs:
# SOURCE_CONNECTOR=0x...
# DEST_CONNECTOR=0x...
# SOURCE_TOKEN=0x...
# SOURCE_WRAPPED_TOKEN_FACTORY=0x... (deployed with the source Connector)
# DEST_WRAPPED_TOKEN_FACTORY=0x...   (deployed with the dest Connector)
# DEST_WRAPPED_TOKEN=0x...           (dest MockERC20 acting as the wrapped token)

# ---------------------------------------------------------------------------
# Seed test data (Stage 3) — optional
# ---------------------------------------------------------------------------
# SEED_RECIPIENT=0x...   defaults to the PRIVATE_KEY address if unset
# SEED_AMOUNT=1000000000000000000000  (1 000 tokens, 18 decimals)

# ---------------------------------------------------------------------------
# Certora Prover
# ---------------------------------------------------------------------------
CERTORAKEY=

# Set these after deploying adapters on each chain.
# RISC0_ADAPTER_SOURCE=0x...
# SNARK_ADAPTER_SOURCE=0x...
# RISC0_ADAPTER_DEST=0x...
# SNARK_ADAPTER_DEST=0x...
