{
  "name": "stateless-client",
  "version": "0.1.0",
  "description": "TypeScript stateless client and CLI for trustless connector relay flows",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "stateless-client": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_LOCAL_INTEGRATION=1 vitest run test/integration"
  },
  "dependencies": {
    "@corpus-core/colibri-stateless": "^1.1.20",
    "ethers": "^6.16.0"
  },
  "optionalDependencies": {
    "@corpus-core/colibri-stateless-dev": "*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
